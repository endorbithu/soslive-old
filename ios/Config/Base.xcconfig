// SOSlive iOS configuration.
// Every value is optional. Override them in Config/Secrets.xcconfig (git-ignored):
//   cp Config/Secrets.example.xcconfig Config/Secrets.xcconfig
// The RTMP target itself comes from the backend (mock-server/.env -> RTMP_URL).

// Backend base URL. xcconfig treats "//" as a comment, hence the "$()" trick.
// The iOS simulator reaches the Mac's mock server on localhost.
SOSLIVE_API_BASE_URL = http:/$()/localhost:3000/

// Google Sign-In: iOS OAuth client id + its reversed form (URL scheme), and the *Web*
// client id (the ID token audience the backend verifies). Empty = simulated Google login.
GOOGLE_IOS_CLIENT_ID =
GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.notconfigured
GOOGLE_WEB_CLIENT_ID =

// Facebook Login. Empty = simulated Facebook login.
FACEBOOK_APP_ID =
FACEBOOK_CLIENT_TOKEN =

// Apple developer team for signing on a real device.
SOSLIVE_DEVELOPMENT_TEAM =

#include? "Secrets.xcconfig"
