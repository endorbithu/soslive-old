// Copy to Secrets.xcconfig (git-ignored) and fill in what you need.

// SOSLIVE_WEBAPP_URL = https:/$()/soslive.example.com

// Real device: your stream server / Mac's LAN IP.
// SOSLIVE_STREAM_RTMP_URL = rtmp:/$()/192.168.1.10:1935/live
// SOSLIVE_STREAM_HLS_TEMPLATE = https:/$()/stream.example.com/live/{key}/index.m3u8

// GOOGLE_IOS_CLIENT_ID = 1234-abc.apps.googleusercontent.com
// GOOGLE_REVERSED_CLIENT_ID = com.googleusercontent.apps.1234-abc

// SOSLIVE_DEVELOPMENT_TEAM = ABCDE12345
