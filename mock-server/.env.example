# ============================================================
#  SOSlive mock backend configuration
#  Copy to .env - RTMP_URL is the ONLY required value.
# ============================================================

# RTMP ingest URL the app publishes to. The stream key is appended: <RTMP_URL>/<key>
#   own server (SRS / nginx-rtmp / MediaMTX): rtmp://my-server:1935/live
#   docker compose --profile rtmp (MediaMTX) : rtmp://<your-LAN-IP>:1935/live
#   YouTube                                   : rtmp://a.rtmp.youtube.com/live2   (+ RTMP_STREAM_KEY)
RTMP_URL=rtmp://your-rtmp-server:1935/live

# Optional: one fixed stream key for every event (YouTube / Facebook Live key).
# Empty = a unique key per event: {yyyymmdd}_{userId}_{eventId}_{hash}
RTMP_STREAM_KEY=
RTMP_KEY_PREFIX=

# ---- optional ----
PORT=3000
# Base URL of this server as seen from outside - used in the link sent in SOS SMS.
PUBLIC_WEB_URL=http://localhost:3000
# Set a fixed secret so logins survive restarts.
JWT_SECRET=change-me-dev-secret
ACCESS_TOKEN_TTL_SEC=900
REFRESH_TOKEN_TTL_SEC=2592000
DB_FILE=data/db.json
UPLOAD_DIR=data/uploads
# Creates demo@soslive.local / demo1234 when the database is empty.
SEED_DEMO_USER=true

# SSO - leave empty to SIMULATE (accepts "mock:<email>" tokens and unverified Google ID tokens).
# Must be the *Web* client id that the app also uses as serverClientId.
GOOGLE_CLIENT_ID=
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
